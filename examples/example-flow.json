[
    {
        "id": "shutter-example-tab",
        "type": "tab",
        "label": "ui-shutter example",
        "disabled": false,
        "info": "Self-contained demo: a shutter and a blind, each with a fake KNX round-trip (function nodes echo the commanded position/slats back as a status message after a short delay, the way a real KNX status group address would).",
        "env": []
    },
    {
        "id": "shutter-example-base",
        "type": "ui-base",
        "theme": "",
        "path": "/dashboard",
        "site": {
            "name": "Node-RED Dashboard",
            "sizes": { "sm": 400, "md": 700, "lg": 1000, "xl": 1300 },
            "allowSwipe": "false",
            "lockMenu": "false",
            "allowTempTheme": "true",
            "dateFormat": "DD/MM/YYYY",
            "sizesLocked": "false"
        }
    },
    {
        "id": "shutter-example-page",
        "type": "ui-page",
        "name": "Shutters",
        "ui": "shutter-example-base",
        "path": "/shutters",
        "icon": "home",
        "layout": "grid",
        "theme": "",
        "breakpoints": [
            { "name": "Default", "px": 0, "cols": 3 },
            { "name": "Tablet", "px": 576, "cols": 3 },
            { "name": "Small Desktop", "px": 768, "cols": 6 },
            { "name": "Desktop", "px": 1024, "cols": 6 }
        ],
        "order": 1,
        "className": "",
        "visible": true,
        "disabled": false
    },
    {
        "id": "shutter-example-group",
        "type": "ui-group",
        "name": "Demo",
        "page": "shutter-example-page",
        "width": "6",
        "height": "1",
        "order": 1,
        "showTitle": true,
        "className": "",
        "visible": true,
        "disabled": false
    },
    {
        "id": "shutter-example-shutter",
        "type": "ui-shutter",
        "z": "shutter-example-tab",
        "name": "Living room shutter",
        "group": "shutter-example-group",
        "order": 1,
        "width": 3,
        "height": 3,
        "label": "Living room",
        "showLabel": true,
        "labelAlignment": "left",
        "shutterType": "shutter",
        "zeroMeans": "open",
        "showGraphic": true,
        "showButtons": true,
        "showSlider": true,
        "showPositionText": true,
        "textOpen": "Open",
        "textClosed": "Closed",
        "color": "#607d8b",
        "skyColor": "#bbdefb",
        "buttonColor": "#607d8b",
        "buttonIconStyle": "arrow",
        "positionProperty": "payload",
        "slatProperty": "slats",
        "upValue": "false",
        "upValueType": "bool",
        "downValue": "true",
        "downValueType": "bool",
        "stopValue": "true",
        "stopValueType": "bool",
        "topic": "shutter/living-room",
        "x": 440,
        "y": 140,
        "wires": [["shutter-example-shutter-cmd-log"], ["shutter-example-shutter-cmd-log"], ["shutter-example-shutter-echo"]]
    },
    {
        "id": "shutter-example-shutter-echo",
        "type": "function",
        "z": "shutter-example-tab",
        "name": "fake KNX position echo",
        "func": "// Stand-in for a KNX status group address: real hardware would report\n// its actual position some time after the command, not instantly.\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 200,
        "wires": [["shutter-example-shutter-delay"]]
    },
    {
        "id": "shutter-example-shutter-delay",
        "type": "delay",
        "z": "shutter-example-tab",
        "name": "simulated travel time",
        "pauseType": "delay",
        "timeout": "1.5",
        "timeoutUnits": "seconds",
        "rate": "1",
        "nbRateUnits": "1",
        "rateUnits": "second",
        "randomFirst": "1",
        "randomLast": "5",
        "randomUnits": "seconds",
        "drop": false,
        "allowrate": false,
        "outputs": 1,
        "x": 460,
        "y": 260,
        "wires": [["shutter-example-shutter"]]
    },
    {
        "id": "shutter-example-shutter-cmd-log",
        "type": "debug",
        "z": "shutter-example-tab",
        "name": "shutter command",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 690,
        "y": 140,
        "wires": []
    },
    {
        "id": "shutter-example-shutter-seed",
